# .env example for exchange MVP

# Database
DATABASE_URL=postgres://user:pass@localhost:5432/exchange

# TON
TON_RPC=https://toncenter.com/api/v2/jsonRPC
TON_WALLET_ADDRESS=EQ... (deposit aggregator address)
TON_WALLET_KEY=KEEP_PRIVATE

# BSC
BSC_RPC=https://bsc-dataseed.binance.org/
BSC_CHAIN_ID=56
BSC_WS= (optional websocket)
BSC_PRIVATE_KEY=KEEP_PRIVATE
CSARY_TOKEN_CONTRACT_BSC=0x...

# Rates / Oracles
COINGECKO_API_KEY=optional

# Payments (placeholders; real providers required)
PAYMENT_PROVIDER=manual # or tinkoff/cloudpayments/other
PAYMENT_API_KEY=KEEP_PRIVATE

# Admin
ADMIN_API_KEY=CHANGE_ME

# Misc
NODE_ENV=development
PORT=3000
